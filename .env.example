# ==============================================================================
# Environment Configuration Template for Dhilip M Portfolio
# Copy this file to .env.local for local development.
# Configure these variables in Vercel Project Settings for production.
# ==============================================================================

# Node Environment ('development' | 'production')
NODE_ENV=development

# Canonical Public Website URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Artificial Preloader Delay in Seconds (Float or Integer)
# Example: 1.5 for a 1.5-second brand preloader intro.
# If not provided, set to 0, or empty, the preloader completes immediately without delay.
NEXT_PUBLIC_LOADER_DELAY_SECONDS=1.5

# ------------------------------------------------------------------------------
# SMTP / Email Configuration (Server-Side Only - Never Exposed to Browser)
# ------------------------------------------------------------------------------
# Recommended providers: Resend (via SMTP), SendGrid, Postmark, AWS SES, or Gmail App Password
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username_here
SMTP_PASS=your_smtp_password_here

# Recipient email where client enquiries will be delivered (Dhilip's inbox)
CONTACT_TO_EMAIL=dhilip.dev@example.com

# Verified sender email address configured with your SMTP provider
CONTACT_FROM_EMAIL=portfolio@dhilip.dev
